{
    "projectRoot":  "%USERPROFILE%\\Coding\\Projects",
    "folderGroups":  {
                         "main":  [
                                      "%USERPROFILE%\\Coding\\Projects",
                                      "%USERPROFILE%\\Coding\\School",
                                      "%USERPROFILE%\\Coding\\Experiments"
                                  ],
                         "languages":  [
                                           "%USERPROFILE%\\Coding\\Java",
                                           "%USERPROFILE%\\Coding\\CSharp",
                                           "%USERPROFILE%\\Coding\\Python",
                                           "%USERPROFILE%\\Coding\\Lua",
                                           "%USERPROFILE%\\Coding\\PowerShell",
                                           "%USERPROFILE%\\Coding\\Batch",
                                           "%USERPROFILE%\\Coding\\Databases"
                                       ]
                     },
    "packageGroups":  {
                          "core":  [
                                       "neovim",
                                       "git",
                                       "gh",
                                       "lazygit",
                                       "ripgrep",
                                       "fd",
                                       "fzf",
                                       "curl",
                                       "wget",
                                       "unzip",
                                       "7zip",
                                       "jq",
                                       "wezterm",
                                       "nerd-fonts-jetbrainsmono"
                                   ],
                          "languages":  [
                                            "nodejs-lts",
                                            "python",
